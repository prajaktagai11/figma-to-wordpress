[
  {
    "match": { "nodeType": "TEXT", "nameRegex": "^H([1-6])$" },
    "block": "heading"
  },
  {
    "match": { "nodeType": "TEXT" },
    "block": "paragraph"
  },
  {
    "match": { "nodeType": "FRAME", "nameRegex": "^section-" },
    "block": "group"
  },
  {
    "match": { "nodeType": "RECTANGLE" },
    "block": "image"
  }
]