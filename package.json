{
  "name": "figma-to-wordpress",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "figma2wp": "dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/config/mapping.rules.json dist/src/config/",
    "dev": "ts-node --esm src/dev.ts",
    "lint": "eslint . --ext .ts",
    "start": "node dist/bin/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.4.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.14.10",
    "eslint": "^9.6.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.9.0",
    "eslint-plugin-promise": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}